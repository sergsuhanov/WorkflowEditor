@using Blazor.WorkflowEditor.Components
@typeparam T

<ActivityControl Node="@Node">
    <Preview>
        @*The switch belongs on the card; the display name lives in the properties panel. Its targets can also
          be drawn as links between the steps.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@expressionId">Switch</label>
            <input type="text" class="form-control we-field-input" id="@expressionId" aria-label="Expression"
                   @bind-value="Node.Expression" @onmousedown:stopPropagation @onmouseup:stopPropagation
                   @onmousemove:stopPropagation />
        </div>
        <div class="we-field-columns">
            <div class="we-field-column">
                <FlowTargetSelect Label="Default target" Container="Node.Container" @bind-Value="Node.DefaultTarget" />
            </div>
        </div>
        @foreach (var key in Node.CaseKeys)
        {
            var caseKey = key;
            <div class="we-caption">
                <span class="we-branch-label">Case @caseKey</span>
                <button type="button" class="btn we-branch-clear" title="@($"Remove case {caseKey}")"
                        aria-label="@($"Remove case {caseKey}")" @onclick="() => Node.RemoveCase(caseKey)"
                        @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation>
                    <span class="oi oi-x text-danger" aria-hidden="true"></span>
                </button>
            </div>
            <FlowTargetSelect Label="@($"Case {caseKey} target")" Container="Node.Container"
                              Value="Node.GetCaseTarget(caseKey)" ValueChanged="v => Node.SetCase(caseKey, v)" />
        }
        <div class="we-field-columns">
            <div class="we-field-column">
                <label class="we-field-label" for="@newCaseId">New case</label>
                <input type="text" class="form-control we-field-input" id="@newCaseId" aria-label="New case value"
                       placeholder="Case value" @bind="newKey" @bind:event="oninput" @onmousedown:stopPropagation
                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
            </div>
            <div class="we-field-column">
                <FlowTargetSelect Label="Target" Container="Node.Container" @bind-Value="newTarget" />
            </div>
        </div>
        <button type="button" class="btn btn-outline-primary" @onclick="addCase"
                @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation>Add case</button>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public FlowSwitchNode<T> Node { get; set; } = default!;

    private string newKey = string.Empty;
    private int newTarget = -1;

    /// <summary>Several cards can be on the diagram at once, so the inputs need ids of their own.</summary>
    private string expressionId => $"we-flowswitch-expression-{Node.Id}";

    private string newCaseId => $"we-flowswitch-new-case-{Node.Id}";

    private void addCase()
    {
        if (Node.SetCase(newKey, newTarget))
        {
            newKey = string.Empty;
            newTarget = -1;
        }
    }
}
