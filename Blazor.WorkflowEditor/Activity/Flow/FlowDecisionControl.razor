@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*The decision belongs on the card; the display name lives in the properties panel. Its branches are
          drawn as links between the steps, so the card carries no target of its own: the True branch leaves the
          left edge of the card and the False one its right edge.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@conditionId">If</label>
            <input type="text" class="form-control we-field-input" id="@conditionId" aria-label="Condition"
                   placeholder="True" @bind-value="Node.Condition" @onmousedown:stopPropagation
                   @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public FlowDecisionNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the input needs an id of its own.</summary>
    private string conditionId => $"we-decision-condition-{Node.Id}";
}
