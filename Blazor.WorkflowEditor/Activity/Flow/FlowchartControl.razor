@using Blazor.WorkflowEditor.Components

@*Card of a Flowchart: the nodes it holds are laid out and connected on the surface of the opened container, so
  the card carries nothing but its name and its `Open` action, exactly like the card of a Sequence. The one choice
  the container keeps outside its canvas, the node that runs first, is made on that surface with the START badge.*@
<ActivityControl Node="@Node"></ActivityControl>

@code {
    [Parameter]
    public FlowchartNode Node { get; set; } = default!;
}
