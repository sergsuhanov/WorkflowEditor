@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*A flowchart is filled and connected inside the opened container, so the card only carries the one
          choice that is not made there: which step starts it.*@
        <FlowTargetSelect Label="Start node" Container="Node" @bind-Value="Node.StartIndex" />
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public FlowchartNode Node { get; set; } = default!;
}
