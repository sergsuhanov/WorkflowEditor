@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*States and transitions are edited inside the opened container, so the card only carries the one
          choice that is not made there: which state starts the machine.*@
        <FlowTargetSelect Label="Initial state" Container="Node" @bind-Value="Node.InitialIndex" />
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public StateMachineNode Node { get; set; } = default!;
}
