@using Blazor.WorkflowEditor.Components
@typeparam T

<ActivityControl Node="@Node">
    <Preview>
        @*The body holds a single activity, rendered inside the card through its own control.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.BodySlot" Label="Body">
                <EmbeddedActivity Slot="@Node.BodySlot" />
            </ActivityRegion>
        </div>
    </Preview>
    <Edit>
        <div class="mb-3">
            <label for="values" class="form-label">Values (Visual Basic expression)</label>
            <input type="text" class="form-control" id="values" @bind-value="Node.Values" placeholder="items"
                   @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
        <div class="mb-3">
            <label for="itemName" class="form-label">Item name</label>
            <input type="text" class="form-control" id="itemName" @bind-value="Node.ItemName"
                   @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
        <div class="form-text">Drop an activity onto the body; it is edited on the node itself.</div>
    </Edit>
</ActivityControl>

@code {
    [Parameter]
    public ForEachNode<T> Node { get; set; } = default!;
}
