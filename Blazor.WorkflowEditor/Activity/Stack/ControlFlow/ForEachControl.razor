@using Blazor.WorkflowEditor.Components
@typeparam T

<ActivityControl Node="@Node">
    <Preview>@fields</Preview>
    <Edit>
        @fields
        @*The body holds a single activity, rendered inside the card through its own control.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.BodySlot" Label="Body">
                <EmbeddedActivity Slot="@Node.BodySlot" />
            </ActivityRegion>
        </div>
    </Edit>
</ActivityControl>

@code {
    [Parameter]
    public ForEachNode<T> Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the inputs need ids of their own.</summary>
    private string valuesId => $"we-foreach-values-{Node.Id}";

    private string itemId => $"we-foreach-item-{Node.Id}";

    /// <summary>
    /// Both fields of the loop are the card while it is closed and stay above the body while it is open: they are
    /// rendered in both blocks.
    /// </summary>
    private RenderFragment fields => @<text>
        <div class="we-field-columns">
            <div class="we-field-column">
                <label class="we-field-label" for="@valuesId">Values</label>
                <input type="text" class="form-control we-field-input" id="@valuesId" placeholder="items"
                       aria-label="Values" @bind-value="Node.Values" @onmousedown:stopPropagation
                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
            </div>
            <div class="we-field-column">
                <label class="we-field-label" for="@itemId">Item</label>
                <input type="text" class="form-control we-field-input" id="@itemId" placeholder="item"
                       aria-label="Item name" @bind-value="Node.ItemName" @onmousedown:stopPropagation
                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
            </div>
        </div>
    </text>;
}
