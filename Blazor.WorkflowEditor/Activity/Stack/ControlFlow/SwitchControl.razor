@using Blazor.WorkflowEditor.Components
@typeparam T

<ActivityControl Node="@Node">
    <Preview>
        @*The expression and the cases of the switch belong on the card; the display name lives in the
          properties panel.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@expressionId">Switch</label>
            <input type="text" class="form-control we-field-input" id="@expressionId" aria-label="Expression"
                   @bind-value="Node.Expression" @onmousedown:stopPropagation @onmouseup:stopPropagation
                   @onmousemove:stopPropagation />
        </div>
        @*Default and every case hold a single activity each, rendered inside the card.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.DefaultSlot" Label="Default">
                <EmbeddedActivity Slot="@Node.DefaultSlot" />
            </ActivityRegion>
            @foreach (var key in Node.CaseKeys)
            {
                var caseKey = key;
                var caseSlot = Node.CaseSlot(caseKey);
                <ActivityRegion Node="Node" Slot="@caseSlot" Label="@($"Case {caseKey}")" CanClear="true"
                                OnClear="@(() => removeCase(caseKey))">
                    <EmbeddedActivity Slot="@caseSlot" />
                </ActivityRegion>
            }
            <div class="we-field-row">
                <input type="text" class="form-control we-field-input" aria-label="New case value"
                       placeholder="@($"New case ({typeof(T).Name})")" @bind="newCaseKey" @bind:event="oninput"
                       @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation />
                <button type="button" class="btn btn-outline-primary" @onclick="addCase"
                        @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation>Add case</button>
            </div>
            @if (!string.IsNullOrEmpty(caseError))
            {
                <div class="text-danger" role="alert">@caseError</div>
            }
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public SwitchNode<T> Node { get; set; } = default!;

    private string newCaseKey = string.Empty;
    private string? caseError;

    /// <summary>Several cards can be on the diagram at once, so the input needs an id of its own.</summary>
    private string expressionId => $"we-switch-expression-{Node.Id}";

    private void addCase()
    {
        if (Node.AddCase(newCaseKey))
        {
            newCaseKey = string.Empty;
            caseError = null;
        }
        else
        {
            caseError = $"Enter a valid, unique {typeof(T).Name} case value.";
        }
    }

    private void removeCase(string key)
    {
        if (Node.RemoveCase(key))
            caseError = null;
    }
}
