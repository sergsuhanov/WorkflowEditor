@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*The exception the catch section handles belongs on the card: it decides what the section means. The
          card is not expandable, the display name lives in the properties panel.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@exceptionTypeId">Catch</label>
            <select class="form-select we-field-input" id="@exceptionTypeId" aria-label="Catch exception type"
                    @bind="Node.SelectedExceptionTypeName" @onmousedown:stopPropagation @onmouseup:stopPropagation
                    @onmousemove:stopPropagation>
                @foreach (var type in TryCatchNode.CatchExceptionTypes)
                {
                    <option value="@type.FullName">@type.Name</option>
                }
            </select>
        </div>
        @*Try, Catch and Finally hold a single activity each, rendered inside the card.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.TrySlot" Label="Try">
                <EmbeddedActivity Slot="@Node.TrySlot" />
            </ActivityRegion>
            <ActivityRegion Node="Node" Slot="@Node.CatchSlot" Label="Catch">
                <EmbeddedActivity Slot="@Node.CatchSlot"
                                  Placeholder="@($"(handler for {Node.SelectedExceptionType.Name} is not set)")" />
            </ActivityRegion>
            <ActivityRegion Node="Node" Slot="@Node.FinallySlot" Label="Finally">
                <EmbeddedActivity Slot="@Node.FinallySlot" />
            </ActivityRegion>
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public TryCatchNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the select needs an id of its own.</summary>
    private string exceptionTypeId => $"we-catch-type-{Node.Id}";
}
