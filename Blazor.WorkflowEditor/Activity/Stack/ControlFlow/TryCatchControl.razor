@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*Try, Catch and Finally hold a single activity each, rendered inside the card.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.TrySlot" Label="Try">
                <EmbeddedActivity Slot="@Node.TrySlot" />
            </ActivityRegion>
            <ActivityRegion Node="Node" Slot="@Node.CatchSlot" Label="@catchLabel">
                <EmbeddedActivity Slot="@Node.CatchSlot"
                                  Placeholder="@($"(no handler for {Node.SelectedExceptionType.Name})")" />
            </ActivityRegion>
            <ActivityRegion Node="Node" Slot="@Node.FinallySlot" Label="Finally">
                <EmbeddedActivity Slot="@Node.FinallySlot" />
            </ActivityRegion>
        </div>
    </Preview>
    <Edit>
        <div class="mb-3">
            <label for="exceptionType" class="form-label">Catch exception type</label>
            <select class="form-select" id="exceptionType" @bind="Node.SelectedExceptionTypeName" @onmousedown:stopPropagation
                    @onmouseup:stopPropagation @onmousemove:stopPropagation>
                @foreach (var type in TryCatchNode.CatchExceptionTypes)
                {
                    <option value="@type.FullName">@type.Name</option>
                }
            </select>
        </div>
        <div class="form-text">Drop an activity onto a section; it is edited on the node itself.</div>
    </Edit>
</ActivityControl>

@code {
    [Parameter]
    public TryCatchNode Node { get; set; } = default!;

    private string catchLabel => $"Catch {Node.SelectedExceptionType.Name}";
}
