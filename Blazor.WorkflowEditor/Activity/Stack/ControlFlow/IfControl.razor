@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*A branch holds a single activity, which is rendered inside the card through its own control.*@
        <div class="we-branches we-branches-stacked">
            @foreach (var slot in Node.Slots)
            {
                var item = slot;
                <ActivityRegion Node="Node" Slot="item" Label="@item.SlotLabel">
                    <EmbeddedActivity Slot="item" />
                </ActivityRegion>
            }
        </div>
    </Preview>
    <Edit>
        <div class="mb-3">
            <label for="condition" class="form-label">Condition (Visual Basic expression)</label>
            <input type="text" class="form-control" id="condition" @bind-value="Node.Condition" placeholder="True"
                   @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
        <div class="form-text">Drop an activity onto the Then or Else branch; it is edited on the node itself.
        </div>
    </Edit>
</ActivityControl>

@code {
    [Parameter]
    public IfNode Node { get; set; } = default!;
}
