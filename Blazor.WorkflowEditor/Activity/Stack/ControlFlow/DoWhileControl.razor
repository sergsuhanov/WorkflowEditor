@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>@fields</Preview>
    <Edit>
        @fields
        @*The body holds a single activity, rendered inside the card through its own control.*@
        <div class="we-branches we-branches-stacked">
            <ActivityRegion Node="Node" Slot="@Node.BodySlot" Label="Body">
                <EmbeddedActivity Slot="@Node.BodySlot" />
            </ActivityRegion>
        </div>
    </Edit>
</ActivityControl>

@code {
    [Parameter]
    public DoWhileNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the input needs an id of its own.</summary>
    private string conditionId => $"we-dowhile-condition-{Node.Id}";

    /// <summary>
    /// The condition ends the loop, so it is the card while it is closed and stays above the body while it is
    /// open: the field is rendered in both blocks.
    /// </summary>
    private RenderFragment fields => @<text>
        <div class="we-field-row">
            <label class="we-field-label" for="@conditionId">Do while</label>
            <input type="text" class="form-control we-field-input" id="@conditionId" placeholder="True"
                   aria-label="DoWhile condition" @bind-value="Node.Condition" @onmousedown:stopPropagation
                   @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
    </text>;
}
