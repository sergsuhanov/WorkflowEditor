@using Blazor.WorkflowEditor.Components;
@typeparam T

<ActivityControl Node="@Node">
    <Preview>
        @*The collection and the item belong on the card; the display name lives in the properties panel.*@
        <AddToCollectionProperties Node="Node"></AddToCollectionProperties>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public AddToCollectionNode<T> Node { get; set; } = default!;
}
