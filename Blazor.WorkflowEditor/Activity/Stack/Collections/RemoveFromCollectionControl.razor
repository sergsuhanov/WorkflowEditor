@using System.Collections
@using Blazor.WorkflowEditor.Components;
@typeparam T

<ActivityControl Node="@Node">
    <Preview>
        @*The collection and the item belong on the card; the display name lives in the properties panel.*@
        <VariableSelectControl Label="Collection" @bind-Value="Node.Collection" VariableCollection="VariableCollection">
        </VariableSelectControl>
        <VariableSelectControl Label="Item" @bind-Value="Node.Item" VariableCollection="Variables">
        </VariableSelectControl>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public RemoveFromCollectionNode<T> Node { get; set; } = default!;

    private List<Variable> VariableCollection
    {
        get
        {
            var nodeType = Node.GetType();
            var cType = typeof(List<>).MakeGenericType(nodeType.GenericTypeArguments);
            return Node.service.Variables.Where(t => t.Type == cType).ToList();
        }
    }

    private List<Variable> Variables
    {
        get
        {
            var nodeType = Node.GetType();
            return Node.service.Variables.Where(t => nodeType.GenericTypeArguments.Contains(t.Type)).ToList();
        }
    }

}
