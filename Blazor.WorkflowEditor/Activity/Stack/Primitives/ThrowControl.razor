@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*The thrown exception belongs on the card; the display name lives in the properties panel.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@exceptionId">Exception</label>
            <input type="text" class="form-control we-field-input" id="@exceptionId" aria-label="Exception"
                   placeholder="New Exception(&quot;error&quot;)" @bind-value="Node.Exception"
                   @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation />
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public ThrowNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the input needs an id of its own.</summary>
    private string exceptionId => $"we-throw-exception-{Node.Id}";
}
