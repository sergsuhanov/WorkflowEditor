@using Blazor.WorkflowEditor.Components

<ActivityControl Node="@Node">
    <Preview>
        @*The reason belongs on the card; the display name lives in the properties panel.*@
        <div class="we-field-row">
            <label class="we-field-label" for="@reasonId">Reason</label>
            <input type="text" class="form-control we-field-input" id="@reasonId" aria-label="Reason"
                   @bind-value="Node.Reason" @onmousedown:stopPropagation @onmouseup:stopPropagation
                   @onmousemove:stopPropagation />
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public TerminateWorkflowNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the input needs an id of its own.</summary>
    private string reasonId => $"we-terminate-reason-{Node.Id}";
}
