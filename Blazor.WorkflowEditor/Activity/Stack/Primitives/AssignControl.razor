@using Blazor.WorkflowEditor.Components;

<ActivityControl Node="@Node">
    <Preview>
        @*Both sides of the assignment belong on the card; the display name lives in the properties panel.*@
        <div class="we-field-columns">
            <div class="we-field-column">
                <label class="we-field-label" for="@destinationId">Destination</label>
                <input type="text" class="form-control we-field-input" id="@destinationId" aria-label="Destination"
                       placeholder="Input destination" @bind-value="Node.Destination" @onmousedown:stopPropagation
                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
            </div>
            <div class="we-field-column">
                <label class="we-field-label" for="@sourceId">Source</label>
                <input type="text" class="form-control we-field-input" id="@sourceId" aria-label="Source"
                       placeholder="Input source" @bind-value="Node.Source" @onmousedown:stopPropagation
                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
            </div>
        </div>
    </Preview>
</ActivityControl>

@code {
    [Parameter]
    public AssignNode Node { get; set; } = default!;

    /// <summary>Several cards can be on the diagram at once, so the inputs need ids of their own.</summary>
    private string destinationId => $"we-assign-destination-{Node.Id}";

    private string sourceId => $"we-assign-source-{Node.Id}";
}

