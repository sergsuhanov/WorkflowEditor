@using Blazor.WorkflowEditor
@using Blazor.WorkflowEditor.Activity.Flow

@*The cue of the current canvas: the box asks for the element the surface has none of yet. Only a Flowchart
  carries a badge and an arrow with it, because only there is the start element a choice of the user; every other
  surface is started by its first element, so its box is a plain request for that element.*@
@if (Service?.StartHint is { } hint)
{
    <div class="we-root-start-presentation" style="left:50%;top:12px;" aria-hidden="true">
        @if (Service.OpenedGraph is FlowchartNode)
        {
            <div class="we-root-start-badge">START</div>
            <div class="we-root-start-arrow"></div>
        }
        <div class="we-root-start-drop">@hint</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Service Service { get; set; } = default!;
}
