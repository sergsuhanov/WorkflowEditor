@using Blazor.WorkflowEditor
@using Blazor.WorkflowEditor.Activity.Flow

@*The cue of the current canvas: it asks for the element the surface holds none of yet. The request itself is a
  plain line of text centred on the surface, because an empty surface draws nothing to point at; only a Flowchart
  carries a badge and an arrow with it, because only there is the start element a choice of the user — and the
  badge is the handle that makes that choice, dragged onto the node that should run first.*@
@if (Service?.StartHint is { } hint)
{
    var anchored = Service.OpenedGraph is FlowchartNode;
    <div class="we-root-start-presentation @(anchored ? "is-anchored" : "is-centred")" aria-hidden="true">
        @if (anchored)
        {
            <div class="we-root-start-badge" draggable="true" title="Drag onto the node that runs first"
                 @ondragstart="startRebind" @ondragend="endRebind"
                 @onpointerdown:stopPropagation @onmousedown:stopPropagation>
                START
            </div>
            <div class="we-root-start-arrow"></div>
        }
        <div class="we-root-start-drop">@hint</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Service Service { get; set; } = default!;

    /// <summary>Takes the START badge, so the next card the drag points at becomes the start node.</summary>
    private void startRebind() => Service.BeginStartRebind();

    /// <summary>Ends the START drag, whether or not the badge was dropped on a card.</summary>
    private void endRebind() => Service.EndStartRebind();
}
