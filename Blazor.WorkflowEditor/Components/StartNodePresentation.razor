@using Blazor.WorkflowEditor

@if (Service.ShowStartPresentation && Service.StartTargetNode is null)
{
    <div class="we-root-start-presentation" style="left:50%;top:calc(50% - 56px);" aria-hidden="true">
        <div class="we-root-start-badge">START</div>
        <div class="we-root-start-arrow"></div>
        <div class="we-root-start-drop">@Service.StartHint</div>
    </div>
}
else if (Service.EmptyContainerHint is { } containerHint)
{
    @*The container lays its first child out below the top of the visible area, so the hint sits there.*@
    <div class="we-root-start-presentation" style="left:50%;top:60px;" aria-hidden="true">
        <div class="we-root-start-drop">@containerHint</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Service Service { get; set; } = default!;
}
