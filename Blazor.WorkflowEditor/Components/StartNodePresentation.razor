@using Blazor.WorkflowEditor

@*The start cue of a surface: the badge names the place the execution starts, the arrow points at the element it
  starts with, and the box asks for that element while the surface holds none. Every surface draws the cue at the
  top, where a container lays out its first element.*@
@if (Service?.StartHint is { } hint)
{
    <div class="we-root-start-presentation" style="left:50%;top:12px;" aria-hidden="true">
        <div class="we-root-start-badge">START</div>
        <div class="we-root-start-arrow"></div>
        <div class="we-root-start-drop">@hint</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Service Service { get; set; } = default!;
}
