@using Blazor.WorkflowEditor
@using Blazor.WorkflowEditor.Activity.Flow

@*The cue of the current canvas: it asks for the element the surface holds none of yet. The request itself is a
  plain line of text centred on the surface, because an empty surface draws nothing to point at; only a Flowchart
  carries a badge and an arrow with it, because only there is the start element a choice of the user.*@
@if (Service?.StartHint is { } hint)
{
    var anchored = Service.OpenedGraph is FlowchartNode;
    <div class="we-root-start-presentation @(anchored ? "is-anchored" : "is-centred")" aria-hidden="true">
        @if (anchored)
        {
            <div class="we-root-start-badge">START</div>
            <div class="we-root-start-arrow"></div>
        }
        <div class="we-root-start-drop">@hint</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Service Service { get; set; } = default!;
}
