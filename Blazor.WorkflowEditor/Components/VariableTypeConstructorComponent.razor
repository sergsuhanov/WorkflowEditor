@using System.ComponentModel
@using System.Runtime.CompilerServices
@using Blazor.WorkflowEditor.Activity
@implements IDisposable

<div class="row">
  @if (Value.Value != null)
  {
    <div class="col">
      @if (ChooseAgain)
      {
        <button type="button" class="we-vtc-type link-primary" @onclick="chooseAgain">@Value.Value?.ToString()</button>
      }
      else
      {
        <label class="col-form-label">@Value.Value?.ToString()</label>
      }
      <button type="button" class="btn" @onclick="clearType">
        <span class="oi oi-x text-primary" aria-hidden="true"></span>
      </button>

      @if (Value.Childs.Count > 0)
      {
        <ul class="we-vtc-options">
          @for (var index = 0; index < Value.Childs.Count; index++)
          {
            var child = Value.Childs[index];
            @*A type that is put together here fills the parameters of its definition, so each of its fields is
              offered the types that meet the constraint of the parameter it fills.*@
            var childParameter = parametersOf(Value.Value, index);
            <li class="option">
              <VariableTypeConstructorComponent @key="child" @ref="child.ObjRef" TypeCollection="TypeCollection"
                                                Parameter="childParameter" Value="child">
              </VariableTypeConstructorComponent>
            </li>
          }
        </ul>
      }
    </div>
  }
  @if (Value.Value == null)
  {
    <div class="@(Value.Value != null ? "col-8" : "")">
      <TypeSelectComponent TypeCollection="acceptedTypes" Value="Value.Value" ValueChanged="onTypeSelected"
                           StartOpen="ChooseAgain">
      </TypeSelectComponent>
    </div>
  }
</div>

@code {
  public class TypeItem : INotifyPropertyChanged
  {
    private Type? _value = null;
    public Type? Value
    {
      get => _value;
      set
      {
        if (_value == value) return;
        Childs.Clear();
        if (!isGeneric(value) || value == null)
        {
          _value = value;
        }
        else
        {
          if (isImplementedGeneric(value))
          {
            _value = value.GetGenericTypeDefinition();
            Childs.AddRange(value.GenericTypeArguments.Select(s => new TypeItem { Value = s }).ToList());
          }
          else
          {
            _value = value;
            Childs.AddRange(value.GetGenericArguments().Select(s => new TypeItem { }).ToList());
          }
        }
        OnPropertyChanged();
      }
    }

    public object? ObjRef { get; set; }
    public List<TypeItem> Childs { get; } = new();

    public event PropertyChangedEventHandler? PropertyChanged;
    public void OnPropertyChanged([CallerMemberName] string prop = "")
    {
      if (PropertyChanged != null)
        PropertyChanged(this, new PropertyChangedEventArgs(prop));
    }

    public Type? BuildType()
    {
      if (_value == null || !isGeneric(_value)) return _value;
      var types = Childs.Select(s => s.BuildType()).ToArray();
      if (types.Any(p => p == null)) return null;

      //A type whose arguments do not meet its own parameters cannot be built at all (`MakeGenericType` refuses
      //it), so the form leaves the field incomplete instead of failing: the dialog refuses what it can judge by
      //the whole type.
      var parameters = _value.GetGenericArguments();
      if (types.Where((type, index) => !GenericTypeConstraints.Meets(type, parameters[index])).Any()) return null;

      return _value.MakeGenericType(types!);
    }

    private bool isGeneric(Type? type) => type != null && type?.IsGenericType == true;
    private bool isImplementedGeneric(Type? type) => type != null && type.GenericTypeArguments.Count() != 0;
  }

  private Type? _prevValue;

  /// <summary>
  /// Type the constructor starts from. It only seeds <see cref="Value"/>: the edited type lives in the
  /// <see cref="TypeItem"/> tree, so the value is copied on the way in (a parameter setter would be called
  /// during parameter binding, which Blazor warns about - BL0007).
  /// </summary>
  [Parameter]
  public Type? VariableType { get; set; }

  protected override void OnParametersSet()
  {
    if (_prevValue != VariableType)
    {
      _prevValue = VariableType;
      Value.Value = VariableType;
    }

    base.OnParametersSet();
  }

  /// <summary>A listener that edits the type of a value it already has lets the user choose it again, so the
  /// chosen type becomes the control that opens the picker; a choice left half made survives until the
  /// listener applies the dialog, because only a complete type is read then.</summary>
  [Parameter]
  public bool ChooseAgain { get; set; }

  /// <summary>
  /// Generic parameter the chosen type fills when the field belongs to an activity that is completed: the
  /// picker offers the types that meet the constraints of that parameter, which is what keeps a type that the
  /// activity cannot take out of the list. Null when nothing constrains the field, as in the field that chooses
  /// the type of a variable.
  /// </summary>
  [Parameter]
  public Type? Parameter { get; set; }

  [Parameter]
  public TypeItem Value { get; set; } = new();

  [Parameter, EditorRequired]
  public List<Type>? TypeCollection { get; set; }

  /// <summary>The types the picker of this field offers: the ones that meet the constraint of the parameter
  /// the field fills, which is every type when nothing constrains it.</summary>
  private List<Type> acceptedTypes => GenericTypeConstraints.Accepts(TypeCollection, Parameter);

  /// <summary>The parameter a field of a type that is put together fills: the field at
  /// <paramref name="index"/> of the definition the user chose fills that parameter of its definition.</summary>
  private static Type? parametersOf(Type? definition, int index) {
    var parameters = definition?.GetGenericArguments() ?? Array.Empty<Type>();
    return index < parameters.Length ? parameters[index] : null;
  }

  public Type? BuildedType { get => Value.BuildType(); }

  private void onTypeSelected(Type? type) => Value.Value = type;

  private void clearType() => Value.Value = null;

  private void chooseAgain() => Value.Value = null;

  public void Dispose()
  {
  }
}