@using System.Activities;
@using Blazor.WorkflowEditor;
@using Blazor.WorkflowEditor.Activity;
@implements IDisposable

<div class="we-panel we-variables-panel @(_collapsed ? "is-collapsed" : null)"
     style="@(_collapsed ? null : $"height:{Height}px")">

  <div class="we-panel-header" role="button" tabindex="0" aria-expanded="@(_collapsed ? "false" : "true")"
       aria-label="Variables" title="@(_collapsed ? "Expand the variables panel" : "Collapse the variables panel")"
       @onclick="toggleCollapsed" @onkeydown="onHeaderKeyDown" @onkeydown:preventDefault="true">
    <span class="oi @(_collapsed ? "oi-caret-top" : "oi-caret-bottom") we-panel-caret" aria-hidden="true"></span>
    <span class="we-panel-title">Variables</span>
    <span class="we-panel-actions">
      @*The add button must not toggle the panel, so it stops the click from bubbling to the header.*@
      <button type="button" class="btn we-panel-action" title="Add a variable" aria-label="Add a variable"
              @onclick="() => addVariable()" @onclick:stopPropagation="true">
        <span class="oi oi-plus text-primary" aria-hidden="true"></span>
      </button>
    </span>
  </div>

  @if (!_collapsed)
  {
    <div class="we-panel-body">
      @foreach (var item in _groupedVariables)
      {
        @*The group is keyed by its activity, which is the object that stays the same between renders: the
          group itself is built again on every render, and a key that changed with it would discard the state
          of the fields the user is editing (a type that is half chosen, for instance).*@
        <div class="we-variable-group" @key="item.Activity">
          <div class="we-variable-group-header" role="button" tabindex="0"
               aria-expanded="@(getCollapsedGroup(item) ? "false" : "true")"
               title="@(getCollapsedGroup(item) ? "Show variables of this activity" : "Hide variables of this activity")"
               @onclick="() => reversValueCollapsedGroup(item)">
            <span class="oi @(getCollapsedGroup(item) ? "oi-caret-right" : "oi-caret-bottom") we-panel-caret"
                  aria-hidden="true"></span>
            <span class="we-panel-title">@(item.Activity?.DisplayName ?? "...")</span>
          </div>

          @if (!getCollapsedGroup(item))
          {
            @*The variables are edited in place: a row carries the fields of the variable it shows, so the
              table needs no header and no edit command — the several shapes of a type are chosen in the
              dialog the type opens, and the delete command is the only action left.*@
            <table @key="_tableRevision" class="table table-sm mb-2 we-variables-table">
              <tbody>
                @foreach (var variable in item.Variables)
                {
                  <tr @key="variable">
                    <td class="we-variable-name">
                      <input type="text" class="form-control form-control-sm"
                             aria-label="@($"Name of the variable {variable.Name}")" value="@variable.Name"
                             @onchange="e => renameVariable(variable, e.Value?.ToString())" />
                    </td>
                    <td class="we-variable-type">
                      <button type="button" class="we-vtc-type link-primary"
                              title="Change the type of this variable"
                              aria-label="@($"Type of the variable {variable.Name}: {typeName(variable.Type)}")"
                              @onclick="() => changeType(variable)">@typeName(variable.Type)</button>
                    </td>
                    <td class="we-variable-value">
                      <input type="text" class="form-control form-control-sm"
                             aria-label="@($"Default value of the variable {variable.Name}")"
                             value="@variable.DefaultValue"
                             @onchange="e => setDefaultValue(variable, e.Value?.ToString())" />
                    </td>
                    <td class="we-variable-actions">
                      <button type="button" class="btn we-panel-action" title="Delete the variable"
                              aria-label="@($"Delete variable {variable.Name}")" @onclick="() => removeVariable(variable)">
                        <span class="oi oi-x text-danger" aria-hidden="true"></span>
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </div>
      }
    </div>
  }
</div>


@code {

  public class GroupedActivityVariable
  {
    public System.Activities.Activity? Activity { get; set; }
    public List<Blazor.WorkflowEditor.Variable> Variables { get; set; } = new();
  }

  private Dictionary<string, bool> _collapsedGroup = new();
  private bool _collapsed { get; set; } = false;

  /// <summary>Bumped when a change was refused: the table is built again so its fields show the model.</summary>
  private int _tableRevision;

  private List<GroupedActivityVariable> _groupedVariables
  {
    get
    {
      List<GroupedActivityVariable> result = new List<GroupedActivityVariable>();
      if (Service == null) return result;
      foreach (var item in Service.Variables)
      {
        var group = result.FirstOrDefault(p => p.Activity == item.Activity);
        if (group == null)
        {
          group = new GroupedActivityVariable
          {
            Activity = item.Activity,
            Variables = new List<Blazor.WorkflowEditor.Variable>()
          };
          result.Add(group);
        }
        group.Variables.Add(item);
        if (!_collapsedGroup.ContainsKey($"{group?.Activity?.DisplayName ?? ""}"))
        {
          _collapsedGroup.Add($"{group?.Activity?.DisplayName ?? ""}", false);
        }
      }
      ;
      return result;
    }
  }

  [CascadingParameter]
  private ModalService? _modalService { get; set; }

  [Parameter, EditorRequired]
  public Service Service { get; set; } = default!;

  [Parameter]
  public List<Type> TypeCollection { get; set; } = default!;

  /// <summary>Panel height in pixels, controlled by the editor layout splitter.</summary>
  [Parameter]
  public int Height { get; set; } = 220;

  private void toggleCollapsed() => _collapsed = !_collapsed;

  /// <summary>Enter/Space toggle the panel, exactly like a click on the header.</summary>
  private void onHeaderKeyDown(KeyboardEventArgs e)
  {
    if (e.Key is "Enter" or " " or "Spacebar")
      toggleCollapsed();
  }


  private bool getCollapsedGroup(GroupedActivityVariable group)
  {
    return _collapsedGroup.ContainsKey($"{group?.Activity?.DisplayName ??
""}") ? _collapsedGroup[$"{group?.Activity?.DisplayName ?? ""}"] : false;
  }

  private void reversValueCollapsedGroup(GroupedActivityVariable group)
  {
    if (_collapsedGroup.ContainsKey($"{group?.Activity?.DisplayName ?? ""}"))
    {
      _collapsedGroup[$"{group?.Activity?.DisplayName ?? ""}"] = !_collapsedGroup[$"{group?.Activity?.DisplayName ?? ""}"];
    }
  }

  private async void removeVariable(Blazor.WorkflowEditor.Variable variable)
  {
    if (_modalService == null) return;

    var modal = await _modalService.ShowModal<ConfirmationModal>(new(){
          {"Title","Delete variable"},
          {"Message",$"Delete variable {variable.Name}?"},
          {"ApplyButtonText","Delete"},
        });

    if (modal.ModalResult == ModalResult.Applied)
    {
      Service.RemoveVariable(
          variable.Activity,
          variable.Name);

      Service.RefreshVariables();
    }

    StateHasChanged();
  }

  /// <summary>Renames the variable of a row. A variable without a name cannot be referenced, so an empty
  /// name is refused and the field is redrawn with the name the variable has.</summary>
  private void renameVariable(Blazor.WorkflowEditor.Variable variable, string? typed)
  {
    var name = (typed ?? string.Empty).Trim();

    if (name.Length == 0 || name == variable.Name)
    {
      //The browser keeps what the user typed, so the table is built again to show the model value.
      _tableRevision++;
      return;
    }

    updateVariable(variable, name, variable.Type, defaultValueOf(variable));
  }

  /// <summary>Asks for the type of a variable in the one dialog that asks for a type, which is where a type
  /// that needs parameters of its own (`List<Int32>`) can be put together.</summary>
  private async void changeType(Blazor.WorkflowEditor.Variable variable)
  {
    if (_modalService == null)
      return;

    var modal = await _modalService.ShowModal<TypeSelectModal>(new(){
          {"Fields",new List<TypeSelectModal.TypeField>{ new() }},
          {"TypeCollection",TypeCollection??new List<Type>()},
        });

    if (modal.ModalResult == ModalResult.Applied)
    {
      var type = modal.BuildedTypes.OfType<Type>().FirstOrDefault();
      if (type != null)
        updateVariable(variable, variable.Name, type, defaultValueOf(variable));
    }

    StateHasChanged();
  }

  private void setDefaultValue(Blazor.WorkflowEditor.Variable variable, string? value)
  {
    var defaultValue = value ?? string.Empty;

    if (defaultValue == defaultValueOf(variable))
      return;

    updateVariable(variable, variable.Name, variable.Type, defaultValue);
  }

  private void updateVariable(Blazor.WorkflowEditor.Variable variable, string name, Type type, string defaultValue)
  {
    if (variable.Activity == null)
      return;

    Service.UpdateVariable(variable.Activity, variable.Name, name, type, defaultValue);

    //The panel shows a snapshot of the variables, so the table has to be rebuilt after every change.
    Service.RefreshVariables();
  }

  /// <summary>The default value as the field carries it.</summary>
  private static string defaultValueOf(Blazor.WorkflowEditor.Variable variable)
    => variable.DefaultValue?.ToString() ?? string.Empty;

  /// <summary>The type as the row shows it: a type that takes parameters reads as `List<Int32>` instead of
  /// the CLR name of its definition, which is long enough to wrap a cell of the table.</summary>
  private static string typeName(Type? type)
  {
    if (type == null)
      return string.Empty;

    if (!type.IsGenericType)
      return type.Name;

    var name = type.Name;
    var arguments = string.Join(", ", type.GenericTypeArguments.Select(typeName));
    return $"{name[..name.IndexOf('`')]}<{arguments}>";
  }

  /// <summary>Adds a variable of a fresh name: its row is the form, so the name it starts with only has to
  /// be one nothing else uses, and the user renames it in place.</summary>
  private void addVariable()
  {
    var activity = Service.Path.LastOrDefault()?.Activity;
    if (activity == null)
      return;

    string name;
    for (var index = 1; ; index++)
    {
      name = $"variable{index}";
      if (Service.Variables.All(p => p.Name != name))
        break;
    }

    Service.AddVariable(activity, name, typeof(object), string.Empty);
    Service.RefreshVariables();
  }

  protected override void OnInitialized()
  {
    base.OnInitialized();
  }


  public void Dispose()
  {
  }
}