@using System.Activities;
@using Blazor.WorkflowEditor;
@using Blazor.WorkflowEditor.Activity;
@implements IDisposable

<div class="we-panel we-variables-panel @(_collapsed ? "is-collapsed" : null)"
     style="@(_collapsed ? null : $"height:{Height}px")">

  <div class="we-panel-header" role="button" tabindex="0" aria-expanded="@(_collapsed ? "false" : "true")"
       aria-label="Variables" title="@(_collapsed ? "Expand the variables panel" : "Collapse the variables panel")"
       @onclick="toggleCollapsed" @onkeydown="onHeaderKeyDown" @onkeydown:preventDefault="true">
    <span class="oi @(_collapsed ? "oi-caret-top" : "oi-caret-bottom") we-panel-caret" aria-hidden="true"></span>
    <span class="we-panel-title">Variables</span>
    <span class="we-panel-actions">
      @*The add button must not toggle the panel, so it stops the click from bubbling to the header.*@
      <button type="button" class="btn we-panel-action" disabled="@(addScope == null)"
              title="@addVariableTitle" aria-label="@addVariableTitle"
              @onclick="() => addVariable()" @onclick:stopPropagation="true">
        <span class="oi oi-plus text-primary" aria-hidden="true"></span>
      </button>
    </span>
  </div>

  @if (!_collapsed)
  {
    <div class="we-panel-body">
      @*A variable belongs to a scope that holds it, so a workflow whose path holds none says why the command
        above has nothing to add to instead of leaving the button inert without a reason.*@
      @if (addScope == null)
      {
        <p class="form-text we-variables-hint" role="status">@noScopeHint</p>
      }
      @foreach (var item in _groupedVariables)
      {
        @*The group is keyed by its activity, which is the object that stays the same between renders: the
          group itself is built again on every render, and a key that changed with it would discard the state
          of the fields the user is editing (a type that is half chosen, for instance).*@
        <div class="we-variable-group" @key="item.Activity">
          <div class="we-variable-group-header @(ownsNewVariables(item) ? "is-add-scope" : null)" role="button" tabindex="0"
               aria-expanded="@(isGroupCollapsed(item) ? "false" : "true")"
               aria-label="@groupTitle(item)"
               title="@groupTitle(item)"
               @onclick="() => toggleGroup(item)">
            <span class="oi @(isGroupCollapsed(item) ? "oi-caret-right" : "oi-caret-bottom") we-panel-caret"
                  aria-hidden="true"></span>
            <span class="we-panel-title">@(item.Activity?.DisplayName ?? "...")</span>
            @*How many variables the scope holds stays on the header, so a scope that is collapsed says what
              it hides and a long list is read at a glance.*@
            <span class="we-variable-group-count" aria-hidden="true">@item.Variables.Count</span>
            @*The kind of activity that owns the scope tells two scopes with the same display name apart, and
              the mark says which scope the add command above fills.*@
            <span class="we-variable-group-kind">@scopeKind(item.Activity)</span>
          </div>

          @if (!isGroupCollapsed(item))
          {
            @*The variables are edited in place: a row carries the fields of the variable it shows, so the
              grid needs no header row and no edit command — the several shapes of a type are chosen in the
              dialog the type opens, and the delete command is the only action left. The rows flow into as
              many columns as the width of the panel allows, because the panel is wide and short: a scope of
              many variables is read and scrolled in the place the panel has instead of in one long list.*@
            <div @key="_gridRevision" class="we-variables-grid">
              @foreach (var variable in item.Variables)
              {
                <div class="we-variable-row" @key="variable">
                  <input type="text" class="form-control form-control-sm we-variable-name"
                         aria-label="@($"Name of the variable {variable.Name}")" value="@variable.Name"
                         @onchange="e => renameVariable(variable, e.Value?.ToString())" />
                  <button type="button" class="we-vtc-type link-primary we-variable-type"
                          title="Change the type of this variable"
                          aria-label="@($"Type of the variable {variable.Name}: {variable.Type.DisplayName()}")"
                          @onclick="() => changeType(variable)">@variable.Type.DisplayName()</button>
                  <input type="text" class="form-control form-control-sm we-variable-value"
                         aria-label="@($"Default value of the variable {variable.Name}")"
                         value="@variable.DefaultValue"
                         @onchange="e => setDefaultValue(variable, e.Value?.ToString())" />
                  <button type="button" class="btn we-panel-action we-variable-actions" title="Delete the variable"
                          aria-label="@($"Delete variable {variable.Name}")" @onclick="() => removeVariable(variable)">
                    <span class="oi oi-x text-danger" aria-hidden="true"></span>
                  </button>
                </div>
              }
            </div>
          }
        </div>
      }
    </div>
  }
</div>


@code {

  public class GroupedActivityVariable
  {
    public System.Activities.Activity? Activity { get; set; }
    public List<Blazor.WorkflowEditor.Variable> Variables { get; set; } = new();
  }

  /// <summary>The scopes whose groups the user collapsed. An activity is its own key: scopes are compared by
  /// identity, so two of a kind stay independent.</summary>
  private readonly HashSet<System.Activities.Activity> _collapsedGroups = new();
  private bool _collapsed { get; set; } = false;

  /// <summary>Bumped when a change was refused: the grid is built again so its fields show the model.</summary>
  private int _gridRevision;

  private List<GroupedActivityVariable> _groupedVariables
  {
    get
    {
      List<GroupedActivityVariable> result = new List<GroupedActivityVariable>();
      if (Service == null) return result;
      foreach (var item in Service.Variables)
      {
        var group = result.FirstOrDefault(p => p.Activity == item.Activity);
        if (group == null)
        {
          group = new GroupedActivityVariable
          {
            Activity = item.Activity,
            Variables = new List<Blazor.WorkflowEditor.Variable>()
          };
          result.Add(group);
        }
        group.Variables.Add(item);
      }
      return result;
    }
  }

  [CascadingParameter]
  private ModalService? _modalService { get; set; }

  [Parameter, EditorRequired]
  public Service Service { get; set; } = default!;

  [Parameter]
  public List<Type> TypeCollection { get; set; } = default!;

  /// <summary>Panel height in pixels, controlled by the editor layout splitter.</summary>
  [Parameter]
  public int Height { get; set; } = 220;

  private void toggleCollapsed() => _collapsed = !_collapsed;

  /// <summary>Enter/Space toggle the panel, exactly like a click on the header.</summary>
  private void onHeaderKeyDown(KeyboardEventArgs e)
  {
    if (e.Key is "Enter" or " " or "Spacebar")
      toggleCollapsed();
  }


  /// <summary>
  /// Whether the group is collapsed. The state is kept per scope and not per name, because two scopes of the
  /// same kind carry the same display name ("Sequence") and collapsing one must not collapse the other.
  /// </summary>
  private bool isGroupCollapsed(GroupedActivityVariable group) =>
      group.Activity != null && _collapsedGroups.Contains(group.Activity);

  private void toggleGroup(GroupedActivityVariable group)
  {
    if (group.Activity is not { } activity)
      return;

    if (!_collapsedGroups.Add(activity))
      _collapsedGroups.Remove(activity);
  }

  private async Task removeVariable(Blazor.WorkflowEditor.Variable variable)
  {
    if (_modalService == null) return;

    var modal = await _modalService.ShowModal<ConfirmationModal>(new(){
          {"Title","Delete variable"},
          {"Message",$"Delete variable {variable.Name}?"},
          {"ApplyButtonText","Delete"},
        });

    if (modal.ModalResult == ModalResult.Applied)
    {
      Service.RemoveVariable(
          variable.Activity,
          variable.Name);

      Service.RefreshVariables();
    }

    StateHasChanged();
  }

  /// <summary>Renames the variable of a row. A variable without a name cannot be referenced, so an empty
  /// name is refused and the field is redrawn with the name the variable has.</summary>
  private void renameVariable(Blazor.WorkflowEditor.Variable variable, string? typed)
  {
    var name = (typed ?? string.Empty).Trim();

    if (name.Length == 0 || name == variable.Name)
    {
      //The browser keeps what the user typed, so the grid is built again to show the model value.
      _gridRevision++;
      return;
    }

    updateVariable(variable, name, variable.Type, defaultValueOf(variable));
  }

  /// <summary>Asks for the type of a variable in the one dialog that asks for a type, which is where a type
  /// that needs parameters of its own (`List<Int32>`) can be put together.</summary>
  private async Task changeType(Blazor.WorkflowEditor.Variable variable)
  {
    if (_modalService == null)
      return;

    var modal = await _modalService.ShowModal<TypeSelectModal>(new(){
          {"Fields",new List<TypeSelectModal.TypeField>{ new() }},
          {"TypeCollection",TypeCollection??new List<Type>()},
        });

    if (modal.ModalResult == ModalResult.Applied)
    {
      var type = modal.BuildedTypes.OfType<Type>().FirstOrDefault();
      if (type != null)
        updateVariable(variable, variable.Name, type, defaultValueOf(variable));
    }

    StateHasChanged();
  }

  private void setDefaultValue(Blazor.WorkflowEditor.Variable variable, string? value)
  {
    var defaultValue = value ?? string.Empty;

    if (defaultValue == defaultValueOf(variable))
      return;

    updateVariable(variable, variable.Name, variable.Type, defaultValue);
  }

  private void updateVariable(Blazor.WorkflowEditor.Variable variable, string name, Type type, string defaultValue)
  {
    if (variable.Activity == null)
      return;

    Service.UpdateVariable(variable.Activity, variable.Name, name, type, defaultValue);

    //The panel shows a snapshot of the variables, so the table has to be rebuilt after every change.
    Service.RefreshVariables();
  }

  /// <summary>The default value as the field carries it.</summary>
  private static string defaultValueOf(Blazor.WorkflowEditor.Variable variable)
    => variable.DefaultValue?.ToString() ?? string.Empty;

  /// <summary>Adds a variable to the scope the panel is on. A surface that holds no variables of its own adds
  /// to the nearest scope that does, so the command never leaves the panel unchanged without a word (the panel
  /// names the scope above, and says which one is missing when the path holds none).</summary>
  private void addVariable()
  {
    var activity = addScope?.Element;
    if (activity == null)
      return;

    string name;
    for (var index = 1; ; index++)
    {
      name = $"variable{index}";
      if (Service.Variables.All(p => p.Name != name))
        break;
    }

    Service.AddVariable(activity, name, typeof(object), string.Empty);
    Service.RefreshVariables();
  }

  /// <summary>The scope the add command fills: the innermost activity of the path that holds variables. Null
  /// while the path holds none, or while the panel has no workflow yet.</summary>
  private DefaultNode? addScope => Service?.VariableScope;

  /// <summary>The scope the add command fills, named by its activity and its kind.</summary>
  private string addVariableTitle => addScope is { } scope
      ? $"Add a variable to {scope.DisplayName} ({scopeKind(scope.Element)})"
      : "Add a variable";

  /// <summary>Why the add command has nothing to fill: no activity of the opened path holds variables.</summary>
  private const string noScopeHint =
      "No scope here holds variables: a variable belongs to an activity that keeps them — a Sequence, a "
      + "While, a Parallel, a Flowchart or a StateMachine. Open a surface that holds one, or add such an "
      + "activity to the workflow.";

  /// <summary>The kind of activity that owns a scope, which tells two scopes of the same display name apart.</summary>
  private static string scopeKind(object? element) => element switch {
    null => string.Empty,
    System.Activities.DynamicActivity => "ActivityBuilder",
    System.Activities.Activity activity => activity.GetType().Name,
    _ => element.GetType().Name
  };

  /// <summary>Whether the add command fills this group: the group of the innermost scope of the path.</summary>
  private bool ownsNewVariables(GroupedActivityVariable group) =>
      group.Activity != null && ReferenceEquals(addScope?.Element, group.Activity);

  private string groupTitle(GroupedActivityVariable group)
  {
    var name = group.Activity?.DisplayName ?? "this scope";
    var kind = scopeKind(group.Activity);
    var count = group.Variables.Count == 1 ? "1 variable" : $"{group.Variables.Count} variables";
    var action = isGroupCollapsed(group) ? "Show" : "Hide";
    var hint = ownsNewVariables(group) ? " The add command above fills this scope." : string.Empty;
    var named = kind.Length == 0 ? name : $"{name} ({kind})";
    return $"{action} the variables of {named}. {count}.{hint}";
  }

  protected override void OnInitialized()
  {
    base.OnInitialized();
  }


  public void Dispose()
  {
  }
}