@*The activity a slot holds, rendered inside the card of its owner. The card is a drag source of its own, so
  the activity can be moved out of the branch to another target; a container child also keeps its Open action,
  which navigates into it through the path like any other node.*@
@{
    var held = Slot.Held;
    var child = held is null ? null : Service.FindPair(held)?.Node;
    var controlType = child is null ? null : Service.GetControlType(child);
}

@if (held is null)
{
    @*The empty slot keeps the look of the placeholder a new schema starts with.*@
    <div class="we-branch-drop">@Placeholder</div>
}
else if (child is { } node && controlType is { } type)
{
    @*The card of the branch is a drag source of its own: dragging it moves the activity it holds to another
      target instead of dragging the card that draws it, so the pointer events never reach its owner.*@
    <div class="we-embedded" draggable="true"
         @ondragstart:stopPropagation="true" @ondragstart="() => Service.StartCardDrag(node)"
         @ondragend="() => Service.EndCardDrag()"
         @onpointerdown:stopPropagation
         @onclick="() => Service.Select(node)" @onclick:stopPropagation="true">
        <DynamicComponent Type="@type" Parameters="@parameters(node)" />
    </div>
}
else
{
    @*The node of the child is not available, so there is no control to bind; the name still shows the branch.*@
    <span class="we-branch-value">@held.DisplayName</span>
}

@code {
    [CascadingParameter]
    public Service Service { get; set; } = default!;

    [Parameter, EditorRequired]
    public Activity.IActivityHolder Slot { get; set; } = default!;

    /// <summary>Text shown while the slot holds no activity.</summary>
    [Parameter]
    public string Placeholder { get; set; } = "Drop an activity here";

    private static IDictionary<string, object> parameters(Activity.DefaultNode node) =>
        new Dictionary<string, object> { ["Node"] = node };
}
