@using Blazor.WorkflowEditor.Activity

<div class="mb-3">
    <label class="form-label">@Label</label>
    <select class="form-select" value="@Value" @onchange="OnChange"
            @onmousedown:stopPropagation @onmouseup:stopPropagation @onmousemove:stopPropagation>
        <option value="-1">(none)</option>
        @if (Container != null)
        {
            @for (var i = 0; i < Container.Count; i++)
            {
                <option value="@i">@Container.LabelAt(i)</option>
            }
        }
    </select>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public IGraphContainer? Container { get; set; }

    [Parameter]
    public int Value { get; set; } = -1;

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    private Task OnChange(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var index) ? index : -1);
}
