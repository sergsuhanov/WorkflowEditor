@using System.Diagnostics.CodeAnalysis
@using Blazor.WorkflowEditor.Activity

<div class="@nodeClass">
    @if (ReferenceEquals(Service?.StartTargetNode, Node))
    {
        <div class="we-node-start-presentation" aria-hidden="true">
            <div class="we-root-start-badge">START</div>
            <div class="we-root-start-arrow"></div>
        </div>
    }
    <div class="card @Node.CssClass">
        <div class="card-header">
            @*A card that holds detail (a list of children, an inline editor) is opened and closed by the chevron
              that takes the place of the activity icon.*@
            @if (hasDetail)
            {
                <a href="" class="we-node-toggle" title="@(Node.IsExpanded ? "Collapse" : "Expand")"
                   aria-label="@(Node.IsExpanded ? "Collapse" : "Expand")"
                   aria-expanded="@(Node.IsExpanded ? "true" : "false")" @onclick="@toggleDetail" @onclick:preventDefault
                   @onmousedown:stopPropagation @onmouseup:stopPropagation>
                    <span class="oi @(Node.IsExpanded ? "oi-caret-bottom" : "oi-caret-right")" aria-hidden="true"></span>
                </a>
            }
            else if (iconClass != null)
            {
                <span class="@iconClass we-node-icon" aria-hidden="true"></span>
            }
            <span class="we-node-title" title="@Node.DisplayName">@Node.DisplayName</span>
            @Badges
            <div class="float-end">
                @if (Node.IsContainer)
                {
                    <a href="" class="card-link" title="Open" @onclick="@open" @onclick:preventDefault>
                        <span class="oi oi-fullscreen-enter" aria-hidden="true"></span>
                    </a>
                }
                <a href="" class="card-link link-danger" title="Delete" @onclick="@delete" @onclick:preventDefault>
                    <span class="oi oi-circle-x" aria-hidden="true"></span>
                </a>
            </div>
        </div>
        @*The name lives in the header and the note is edited in the properties panel, so the body carries the
          note preview, the preview of the activity and, while the card is expanded, the detail it holds.*@
        @if (Node.HasNote || Preview != null || (Node.IsExpanded && hasDetail))
        {
            <div class="card-body">
                @if (Node.HasNote)
                {
                    <div class="we-note-preview" title="@Node.Note">@Node.Note</div>
                }
                @Preview
                @if (Node.IsExpanded)
                {
                    @Content
                    @if (Edit != null)
                    {
                        <form>
                            <div class="mb-3">
                                <label for="@displayNameId" class="form-label">Display name</label>
                                <input type="text" class="form-control" id="@displayNameId" @bind-value="Node.DisplayName"
                                       placeholder="Input activity display name" @onmousedown:stopPropagation
                                       @onmouseup:stopPropagation @onmousemove:stopPropagation />
                            </div>
                            @Edit
                        </form>
                    }
                }
            </div>
        }

        @*A branch child rendered inside another card, and a card of an ordered container, have no connections
          of their own, so they show no ports.*@
        @if (!Node.IsEmbedded && !Node.IsStackChild)
        {
            foreach (var port in Node.Ports)
            {
                var portClass = port.Locked ? "locked" : "unlocked";
                <PortRenderer Port="port" Class="@portClass"></PortRenderer>
            }
        }
    </div>

</div>

@code {
    [CascadingParameter]
    public Service Service { get; set; } = default!;

    [Parameter]
    public Activity.DefaultNode Node { get; set; } = default!;

    /// <summary>Inline editor of the activity, shown while the card is expanded. A control that does not
    /// provide one (the fallback control does not) has no detail of its own.</summary>
    [Parameter, AllowNull]
    public RenderFragment? Edit { get; set; }

    /// <summary>Optional compact preview shown on the collapsed node card.</summary>
    [Parameter, AllowNull]
    public RenderFragment? Preview { get; set; }

    /// <summary>Editable content of the card, shown under the note preview: the children of an ordered
    /// container, which are edited and reordered inside the card itself.</summary>
    [Parameter, AllowNull]
    public RenderFragment? Content { get; set; }

    private string? iconClass => ActivityIcon.CssClass(Node.Element);

    /// <summary>Whether the card holds detail that the chevron opens and closes.</summary>
    private bool hasDetail => Edit != null || Content != null;

    /// <summary>Unique id of the display name field of the expanded card.</summary>
    private string displayNameId => $"we-activity-display-name-{Node.Id}";

    /// <summary>Badges shown in the card header: the start element marker. Errors are shown by the card
    /// outline and by the properties panel, so they need no badge here.</summary>
    private RenderFragment Badges => @<text>
        @if (isStart)
        {
            <span class="we-node-badge" title="This element is the start of the opened container">
                <span class="@startBadgeClass" aria-hidden="true"></span>@startBadgeText
            </span>
        }
    </text>;

    private IGraphContainer? openedGraph => Service?.OpenedGraph;

    private bool isStart => openedGraph?.IsStartElement(Node.Element) == true;

    private string startBadgeText => openedGraph?.StartBadgeText ?? "Start";

    private string startBadgeClass => openedGraph?.StartBadgeClass ?? "oi oi-media-play";

    private bool hasErrorsInTree => Service?.HasErrorsInTree(Node.Element) ?? false;

    private string nodeClass
    {
        get
        {
            var result = Node.IsExpanded
                ? "we-custom-node we-custom-node-expanded"
                : string.IsNullOrEmpty(Node.NodeLayoutClass)
                    ? "we-custom-node"
                    : $"we-custom-node {Node.NodeLayoutClass}";

            //Start marker and validation state of the card.
            if (isStart)
                result += " we-node-is-start";
            if (hasErrorsInTree)
                result += " we-node-has-errors";

            //A container card hides a whole surface behind its header, so it keeps a body-sized shape.
            if (Node.IsContainer)
                result += " we-node-container";

            //A card of the column of an opened ordered container: the line that shows it belongs to the column,
            //and the caret that shows where a dragged or dropped element lands.
            if (stackIndex >= 0)
            {
                result += " we-stack-child";
                if (Service?.StackCaretAbove(Node) == true)
                    result += " we-stack-caret-above";
                if (Service?.StackCaretBelow(Node) == true)
                    result += " we-stack-caret-below";
            }

            return result;
        }
    }

    /// <summary>Index of this card in the column of the opened ordered container, or -1 when it is not one.</summary>
    private int stackIndex => Node.IsStackChild ? Service?.StackIndexOf(Node) ?? -1 : -1;

    void open()
    {
        Service.Open(Node);
    }

    /// <summary>Opens or closes the detail the card holds.</summary>
    void toggleDetail()
    {
        Node.IsExpanded = !Node.IsExpanded;
        Service?.NotifyStateChanged();
    }
    void delete()
    {
        Service.Delete(Node);
    }

    /// <summary>
    /// A card without an inline editor has nothing to expand, even when the loaded view state says it was
    /// expanded before, so the flag is dropped instead of rendering a form with only the display name.
    /// </summary>
    protected override void OnParametersSet()
    {
        //A card without detail has nothing to open, even when the node it shows was expanded before.
        if (!hasDetail)
            Node.IsExpanded = false;
    }
}