@using System.Diagnostics.CodeAnalysis
@using Blazor.WorkflowEditor.Activity
@using Blazor.WorkflowEditor.Activity.Flow

<div class="@nodeClass" draggable="@(isDraggableCard ? "true" : "false")"
     @ondragstart:stopPropagation="isDraggableCard" @ondragstart="startCardDrag"
     @ondragend="endCardDrag" @onpointerdown:stopPropagation="isDraggableCard"
     @onclick="selectCard" @onclick:stopPropagation="isDraggableCard">
    @if (isStart)
    {
        <div class="we-node-start-presentation" aria-hidden="true">
            <div class="we-root-start-badge">START</div>
            <div class="we-root-start-arrow"></div>
        </div>
    }
    <div class="card @Node.CssClass">
        <div class="card-header">
            @*A card that holds an editor block is opened and closed by the chevron that takes the place of the
              activity icon; a card that only carries the compact fields has no closed state of its own.*@
            @if (hasEditor)
            {
                <a href="" class="we-node-toggle" title="@(Node.IsExpanded ? "Collapse" : "Expand")"
                   aria-label="@(Node.IsExpanded ? "Collapse" : "Expand")"
                   aria-expanded="@(Node.IsExpanded ? "true" : "false")" @onclick="@toggleDetail" @onclick:preventDefault
                   @onmousedown:stopPropagation @onmouseup:stopPropagation>
                    <span class="oi @(Node.IsExpanded ? "oi-caret-bottom" : "oi-caret-right")" aria-hidden="true"></span>
                </a>
            }
            else if (iconClass != null)
            {
                <span class="@iconClass we-node-icon" aria-hidden="true"></span>
            }
            <span class="we-node-title" title="@Node.DisplayName">@Node.DisplayName</span>
            @Badges
            <div class="float-end">
                @if (Node.IsContainer)
                {
                    <a href="" class="card-link" title="Open" @onclick="@open" @onclick:preventDefault>
                        <span class="oi oi-fullscreen-enter" aria-hidden="true"></span>
                    </a>
                }
                @*The remove command is shown only on the selected card, so a surface of many cards is not covered
                  with red circles; the Delete key removes the selected card as well.*@
                @if (Node.Selected)
                {
                    <a href="" class="card-link link-danger" title="Delete" @onclick="@delete" @onclick:preventDefault>
                        <span class="oi oi-circle-x" aria-hidden="true"></span>
                    </a>
                }
            </div>
        </div>
        @*The name lives in the header and the note is edited in the properties panel, so the body carries the note
          preview and one of the two blocks of the card: the compact fields while it is closed, and the editor the
          chevron opens.*@
        @if (Node.HasNote || (Node.IsExpanded ? hasEditor : Preview != null))
        {
            <div class="card-body">
                @if (Node.HasNote)
                {
                    <div class="we-note-preview" title="@Node.Note">@Node.Note</div>
                }
                @if (Node.IsExpanded)
                {
                    @Edit
                }
                else
                {
                    @Preview
                }
            </div>
        }

        @*Only the children of a graph container (Flowchart, StateMachine) are connected to each other, so only
          they offer connection points. A card of an ordered container, a branch child and a card of any other
          surface are placed by their container and get no ports at all.*@
        @if (Node.ShowsPorts)
        {
            foreach (var port in Node.Ports)
            {
                var portClass = port.Locked ? "locked" : "unlocked";
                <PortRenderer Port="port" Class="@portClass"></PortRenderer>
            }
        }
    </div>

</div>

@code {
    [CascadingParameter]
    public Service Service { get; set; } = default!;

    [Parameter]
    public Activity.DefaultNode Node { get; set; } = default!;

    /// <summary>Compact fields of the card, shown while it is closed. They are editable, so the card is edited
    /// in place without opening anything.</summary>
    [Parameter, AllowNull]
    public RenderFragment? Preview { get; set; }

    /// <summary>
    /// Editor of the card, shown while it is open: the fields that do not fit the compact block, the children of
    /// an ordered container, or the branch regions of an activity. The chevron of the card switches the body
    /// between this block and <see cref="Preview"/>, so a card that passes no editor has no chevron.
    /// </summary>
    [Parameter, AllowNull]
    public RenderFragment? Edit { get; set; }

    private string? iconClass => ActivityIcon.CssClass(Node.Element);

    /// <summary>Whether the card holds an editor the chevron opens and closes.</summary>
    private bool hasEditor => Edit != null;

    /// <summary>Badges shown in the card header: the start element marker. Errors are shown by the card
    /// outline and by the properties panel, so they need no badge here.</summary>
    private RenderFragment Badges => @<text>
        @if (isStart)
        {
            <span class="we-node-badge" title="This element is the start of the opened container">
                <span class="@startBadgeClass" aria-hidden="true"></span>@startBadgeText
            </span>
        }
    </text>;

    private FlowchartNode? startFlowchart => Service?.OpenedGraph as FlowchartNode;

    /// <summary>Whether the card carries the start badge of the opened Flowchart, which only it draws.</summary>
    private bool isStart => ReferenceEquals(Service?.StartBadgeNode, Node);

    private string startBadgeText => startFlowchart?.StartBadgeText ?? "Start";

    private string startBadgeClass => startFlowchart?.StartBadgeClass ?? "oi oi-media-play";

    private bool hasErrorsInTree => Service?.HasErrorsInTree(Node.Element) ?? false;

    private string nodeClass
    {
        get
        {
            //Every collapsed card is the same width; an expanded one keeps that width and grows only to fit
            //the nested cards its editor holds.
            var result = Node.IsExpanded
                ? "we-custom-node we-custom-node-expanded"
                : "we-custom-node";

            //Start marker and validation state of the card.
            if (isStart)
                result += " we-node-is-start";
            if (hasErrorsInTree)
                result += " we-node-has-errors";

            //A container card hides a whole surface behind its header, so it keeps a body-sized shape.
            if (Node.IsContainer)
                result += " we-node-container";

            //A card of the column of an opened ordered container: the line that shows it belongs to the column,
            //and the caret that shows where a dragged or dropped element lands.
            if (stackIndex >= 0)
            {
                result += " we-stack-child";
                if (Service?.StackCaretAbove(Node) == true)
                    result += " we-stack-caret-above";
                if (Service?.StackCaretBelow(Node) == true)
                    result += " we-stack-caret-below";
            }

            //The card the user picked up stays visible while it is dragged to another place.
            if (ReferenceEquals(Service?.DraggedCard, Node))
                result += " we-card-dragging";

            return result;
        }
    }

    /// <summary>Index of this card in the column of the opened ordered container, or -1 when it is not one.</summary>
    private int stackIndex => Node.IsStackChild ? Service?.StackIndexOf(Node) ?? -1 : -1;

    /// <summary>
    /// Whether the card is drawn by the column of the opened ordered container. Such a card is dragged as a
    /// card of its own — to another place in the column or to another container — so it takes its pointer events
    /// instead of letting the diagram move the node, and it is selected by its own click.
    /// </summary>
    private bool isDraggableCard => stackIndex >= 0;

    void open()
    {
        Service.Open(Node);
    }

    /// <summary>Picks the card up, so the drop moves the activity it shows to the target the drag points at.</summary>
    void startCardDrag()
    {
        if (isDraggableCard)
            Service?.StartCardDrag(Node);
    }

    /// <summary>Ends the drag, whether or not the card was dropped on a target.</summary>
    void endCardDrag()
    {
        if (isDraggableCard)
            Service?.EndCardDrag();
    }

    /// <summary>Selects the card on click, which the diagram does not do for a card that takes its own pointer events.</summary>
    void selectCard()
    {
        if (isDraggableCard)
            Service?.Select(Node);
    }

    /// <summary>Opens or closes the detail the card holds.</summary>
    void toggleDetail()
    {
        Node.IsExpanded = !Node.IsExpanded;
        Service?.NotifyStateChanged();
    }
    void delete()
    {
        Service.Delete(Node);
    }

    /// <summary>
    /// A card without an editor has nothing to open, even when the loaded view state says it was expanded
    /// before, so the flag is dropped instead of rendering an empty body.
    /// </summary>
    protected override void OnParametersSet()
    {
        //A card without an editor has nothing to open, even when the node it shows was expanded before.
        if (!hasEditor)
            Node.IsExpanded = false;
    }
}