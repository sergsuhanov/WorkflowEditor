@*A dialog that tells the user something and is closed with a single button: a failed save, open or validate,
  or the outcome of a validation run.*@
@implements IDisposable
@implements IModal

<Modal @ref="Modal">
  <Header>
    <ModalHeader TitleText="@Title" OnClose="Modal!.Close"></ModalHeader>
  </Header>

  <Body>
    <p class="@(issues.Count > 0 ? "mb-2" : "mb-0")">@Message</p>
    @if (issues.Count > 0)
    {
      <ul class="we-message-list">
        @foreach (var issue in issues)
        {
          <li>@issue</li>
        }
      </ul>
    }
  </Body>

  <Footer>
    <ModalFooter OnClose="Modal!.Close" OnApply="Modal!.Apply" ApplyButtonText="@CloseButtonText"
                 CancelButtonVisible="false"></ModalFooter>
  </Footer>
</Modal>

@code {
  [Parameter]
  public string? Title { get; set; } = "Workflow editor";

  [Parameter]
  public string? Message { get; set; } = string.Empty;

  /// <summary>Lines the dialog lists under its message, one per line: the errors and warnings of a
  /// validation run, in full.</summary>
  [Parameter]
  public IReadOnlyList<string>? Issues { get; set; }

  [Parameter]
  public string? CloseButtonText { get; set; } = "OK";

  private Modal? Modal { get; set; }

  private IReadOnlyList<string> issues => Issues ?? Array.Empty<string>();

  public ModalResult ModalResult { get => Modal!.ModalResult; }

  public Task<ModalResult> Show()
  {
    return Modal!.Show();
  }

  public void Dispose()
  {
    Modal!.Hide();
  }
}
