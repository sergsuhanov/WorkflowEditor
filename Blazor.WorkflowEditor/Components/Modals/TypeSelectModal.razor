@using Blazor.WorkflowEditor.Activity
@implements IDisposable
@implements IModal

<Modal @ref="Modal">
  <Header>
    <ModalHeader TitleText="Select a type" OnClose="Modal!.Close"></ModalHeader>
  </Header>

  <Body>

      @*The one form that asks for a type, whether it completes the generic parameters of an activity that is
        dropped or changes the type of a variable: one control per field, named where a name says something
        (a generic parameter), because a chosen type can need parameters of its own (`List<T>`).*@
      <div class="we-generic-form">
        @foreach (var item in Fields)
        {
          <div class="we-generic-field">
            @if (!string.IsNullOrEmpty(item.Label))
            {
              <span class="we-generic-key">@item.Label</span>
            }
            <VariableTypeConstructorComponent @key="item" @ref="item.ObjRef" TypeCollection="TypeCollection"
                                              Parameter="item.Parameter" VariableType="item.Value" ChooseAgain="true">
            </VariableTypeConstructorComponent>
          </div>
        }
      </div>
      @if (!string.IsNullOrWhiteSpace(typeError))
      {
        <div class="alert alert-danger mt-2 mb-0" role="alert">@typeError</div>
      }

  </Body>

  <Footer>
    <ModalFooter OnClose="Modal!.Close" OnApply="apply"></ModalFooter>
  </Footer>
</Modal>


@code {
    /// <summary>One type the user chooses: the label it is shown under, where one says something, and the
    /// type it starts from — a field of a dialog that asks for a type starts empty.</summary>
    public class TypeField
    {
        public string Label { get; set; } = string.Empty;
        public Type? Value { get; set; } = null;
        public object? ObjRef { get; set; } = null;

        /// <summary>Generic parameter the chosen type fills, when the field completes an activity that is
        /// dropped: the picker offers the types that meet its constraints, and the dialog refuses a type that
        /// the whole choice shows not to. Null for a field that asks for a type nothing constrains, such as the
        /// type of a variable.</summary>
        public Type? Parameter { get; set; } = null;
    }

    public Modal? Modal { get; set; } = new()!;

    [Parameter]
    public List<Type?> TypeCollection { get; set; } = new();

    [Parameter]
    public List<TypeField> Fields { get; set; } = new();

    public List<Type?> BuildedTypes => Fields.Select(p => p.ObjRef)
      .OfType<VariableTypeConstructorComponent>()
      .Where(p => p != null)
      .Select(p => p.BuildedType).ToList();

    public ModalResult ModalResult => Modal!.ModalResult; 

    private string? typeError;

    private void apply()
    {
      var types = BuildedTypes;
      if (types.Count != Fields.Count || types.Any(type => type == null))
      {
        typeError = "Select a type.";
        return;
      }

      //A type that was put together in the dialog (`List<T>` whose element was chosen) is judged on the whole
      //type and not on the definition the picker offered, so a choice the activity cannot take is refused here,
      //naming the parameter it does not fill, instead of failing when the activity is built.
      for (var index = 0; index < Fields.Count; index++)
      {
        var field = Fields[index];
        var type = types[index];
        if (GenericTypeConstraints.Meets(type, field.Parameter))
          continue;

        typeError = $"The type {type} does not meet the constraints of {describe(field)}: it has to be "
            + $"{GenericTypeConstraints.Describe(field.Parameter)}.";
        return;
      }

      typeError = null;
      Modal!.Apply();
    }

    /// <summary>The field as a message names it: the generic parameter it fills where it says which one that is,
    /// and the field itself otherwise.</summary>
    private static string describe(TypeField field) => string.IsNullOrEmpty(field.Label) ? "this field" : field.Label;

    public Task<ModalResult> Show() {
        return Modal!.Show();
    }

    public void Dispose() {
        Modal!.Hide();

        GC.SuppressFinalize(this);
    }

}