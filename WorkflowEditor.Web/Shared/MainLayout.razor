@using System.Activities
@using System.Text
@using Blazor.WorkflowEditor.Components.Modals
@inherits LayoutComponentBase
@inject IJSRuntime JS


<PageTitle>Workflow editor</PageTitle>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Workflow editor</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavDropdown">
            @*The commands are icons with a tooltip: the title and the accessible name carry what each one
              does, and the file input behind the open command stays reachable with the keyboard.*@
            <ul class="navbar-nav we-commands">
                <li class="nav-item">
                    <button type="button" class="we-command" title="New" aria-label="New" @onclick="New">
                        <span class="oi oi-file" aria-hidden="true"></span>
                    </button>
                </li>
                <li class="nav-item">
                    <label class="we-command" for="workflow-file" title="Open XAML" aria-label="Open XAML">
                        <span class="oi oi-folder" aria-hidden="true"></span>
                    </label>
                    <InputFile id="workflow-file" class="visually-hidden" accept=".xaml,.xml,text/xml,application/xml"
                               OnChange="LoadFile" />
                </li>
                <li class="nav-item">
                    <button type="button" class="we-command" title="Save" aria-label="Save" @onclick="Save">
                        <span class="oi oi-data-transfer-download" aria-hidden="true"></span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="we-command" title="Validate" aria-label="Validate"
                            @onclick="Validate">
                        <span class="oi oi-check" aria-hidden="true"></span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="we-command" title="@themeTitle" aria-label="@themeTitle"
                            @onclick="toggleTheme">
                        <span class="oi @(isDarkTheme ? "oi-sun" : "oi-moon")" aria-hidden="true"></span>
                    </button>
                </li>
                <li class="nav-item d-flex align-items-center">
                    <span class="we-unsaved @(hasUnsavedChanges ? "is-dirty" : string.Empty)" role="status"
                          title="@(hasUnsavedChanges ? "The schema has changes that are not saved yet" : "All changes are saved")">
                        <span class="oi @(hasUnsavedChanges ? "oi-pencil" : "oi-check")" aria-hidden="true"></span>
                        @(hasUnsavedChanges ? "Unsaved changes" : "Saved")
                    </span>
                </li>
            </ul>
        </div>
    </div>
</nav>

            <Blazor.WorkflowEditor.Editor @ref="editor" ToolBoxGroups="groups" TypeCollection="TypeCollection"
                                          DirtyChanged="onDirtyChanged"
                                          OperationFailed="onEditorOperationFailed" />

            @*Every message the page tells the user is a dialog it opens itself, so the page keeps no status line.*@
            <ModalService @ref="modals"></ModalService>

@code {
    private Blazor.WorkflowEditor.Editor? editor = default!;
    private List<Blazor.WorkflowEditor.ToolBoxGroup> groups { get; set; } = new()!;
    private List<Type> TypeCollection { get; set; } = new()!;
    private ModalService? modals;
    private bool hasUnsavedChanges;
    private bool isDarkTheme;

    /// <summary>The theme button shows the theme it switches to, so the tooltip says which one that is.</summary>
    private string themeTitle => isDarkTheme ? "Switch to the light theme" : "Switch to the dark theme";

    private async Task toggleTheme()
    {
        isDarkTheme = !isDarkTheme;
        await JS.InvokeVoidAsync("enableTheme", isDarkTheme ? "dark" : "light");
    }

    private void onDirtyChanged(bool dirty)
    {
        hasUnsavedChanges = dirty;
        StateHasChanged();
    }

    private Task onEditorOperationFailed(string message) => showMessage("Workflow editor", message);

    /// <summary>Tells the user something in a dialog: a failed action, or the outcome of a validation run.</summary>
    private async Task showMessage(string title, string message)
    {
        if (modals == null)
            return;

        await modals.ShowModal<MessageModal>(new()
        {
            { "Title", title },
            { "Message", message }
        });
    }

    /// <summary>Asks the user before a modified schema is replaced by New/Open.</summary>
    private async Task<bool> confirmDiscardChanges()
    {
        if (!hasUnsavedChanges)
            return true;

        return await JS.InvokeAsync<bool>("confirm", "The schema has unsaved changes. Discard them?");
    }


    protected override void OnInitialized()
    {

        var controlFlow = new Blazor.WorkflowEditor.ToolBoxGroup() { Name = "Control Flow" };
        controlFlow.Add<System.Activities.Statements.Sequence>();
        controlFlow.Add<System.Activities.Statements.If>();
        controlFlow.Add<System.Activities.Statements.While>();
        controlFlow.Add<System.Activities.Statements.DoWhile>();
        controlFlow.Add(typeof(System.Activities.Statements.ForEach<>));
        controlFlow.Add<System.Activities.Statements.Parallel>();
        controlFlow.Add<System.Activities.Statements.TryCatch>();
        controlFlow.Add(typeof(System.Activities.Statements.Switch<>));
        groups.Add(controlFlow);

        var primitives = new Blazor.WorkflowEditor.ToolBoxGroup() { Name = "Primitives" };
        primitives.Add<System.Activities.Statements.Assign>();
        primitives.Add(typeof(System.Activities.Statements.Assign<>));
        primitives.Add<System.Activities.Statements.WriteLine>();
        primitives.Add<System.Activities.Statements.Delay>();
        primitives.Add<System.Activities.Statements.Throw>();
        primitives.Add<System.Activities.Statements.Rethrow>();
        primitives.Add<System.Activities.Statements.TerminateWorkflow>();
        groups.Add(primitives);

        var collections = new Blazor.WorkflowEditor.ToolBoxGroup() { Name = "Collections" };
        collections.Add(typeof(System.Activities.Statements.AddToCollection<>));
        collections.Add(typeof(System.Activities.Statements.RemoveFromCollection<>));
        collections.Add(typeof(System.Activities.Statements.ExistsInCollection<>));
        collections.Add(typeof(System.Activities.Statements.ClearCollection<>));
        groups.Add(collections);

        var flowchart = new Blazor.WorkflowEditor.ToolBoxGroup() { Name = "Flowchart" };
        flowchart.Add<System.Activities.Statements.Flowchart>();
        flowchart.Add(typeof(System.Activities.Statements.FlowDecision));
        flowchart.Add(typeof(System.Activities.Statements.FlowSwitch<>));
        groups.Add(flowchart);

        var stateMachine = new Blazor.WorkflowEditor.ToolBoxGroup() { Name = "State Machine" };
        stateMachine.Add<System.Activities.Statements.StateMachine>();
        stateMachine.Add(typeof(System.Activities.Statements.State));
        groups.Add(stateMachine);


        TypeCollection.Add(typeof(System.Object));
        TypeCollection.Add(typeof(System.Int32));
        TypeCollection.Add(typeof(System.String));
        TypeCollection.Add(typeof(System.Boolean));
        TypeCollection.Add(typeof(System.Collections.Generic.List<>));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        //The theme is restored by the script before the editor is rendered, so the button reads what is in
        //effect instead of assuming the light theme.
        isDarkTheme = await JS.InvokeAsync<string>("currentTheme") == "dark";
        New();
        StateHasChanged();
    }

    private async void New()
    {
        if (editor == null)
            return;

        if (!await confirmDiscardChanges())
            return;

        editor.New();
    }

    private async Task Save()
    {
        if (editor == null)
            return;

        try
        {
            var source = editor.Save();
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(Encoding.UTF8.GetBytes(source)));
            await JS.InvokeVoidAsync("downloadFileFromStream", "workflow.xaml", streamRef);
            editor.MarkSaved();
        }
        catch (Exception ex)
        {
            await showMessage("Could not save the workflow", ex.Message);
        }
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        if (!await confirmDiscardChanges())
            return;

        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var source = await reader.ReadToEndAsync();
            editor?.Load(source);
        }
        catch (Exception ex)
        {
            await showMessage("Could not open the workflow", ex.Message);
        }
    }

    private async Task Validate()
    {
        try
        {
            var messages = editor?.Validate();
            await showMessage("Validation", messages == null || messages.Count == 0
                ? "The workflow is valid."
                : $"Validation found {messages.Count} issue(s).");
        }
        catch (Exception ex)
        {
            await showMessage("Could not validate the workflow", ex.Message);
        }
    }
}
